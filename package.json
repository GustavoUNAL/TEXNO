{
  "name": "texno",
  "version": "1.0.0",
  "description": "Análisis estructural de composiciones musicales — ADN de una canción",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "texno": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "analyze": "node src/cli.js",
    "pm2:start": "node scripts/pm2-start.mjs",
    "pm2:stop": "pm2 stop texno",
    "pm2:restart": "node scripts/pm2-start.mjs",
    "pm2:reset": "node scripts/pm2-reset.mjs",
    "vps:update": "git pull && npm install && node scripts/pm2-start.mjs",
    "pm2:logs": "pm2 logs texno",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "paper": "node scripts/generate-paper-pdf.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "music",
    "analysis",
    "dsp",
    "techno",
    "audio"
  ],
  "license": "MIT",
  "dependencies": {
    "@audio/decode": "^3.11.2",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "multer": "^2.2.0",
    "music-metadata": "^10.9.0"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
